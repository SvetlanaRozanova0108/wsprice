# Ключ покупателя из личного кабинета favorit-parts.ru.
# Если не задан, используется демонстрационный ключ из документации.
VITE_API_KEY=00000000-0000-0000-0000-000000000001

# Адрес сервиса. По умолчанию используется /hs/hsprice/ и прокси Vite.
# Для production можно указать полный URL, например:
# VITE_API_BASE=http://api.favorit-parts.ru/hs/hsprice/
VITE_API_BASE=/hs/hsprice/
